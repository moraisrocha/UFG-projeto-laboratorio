{
  "api": {
    "openapi": "3.0.3",
    "baseUrl": "http://localhost:8080/api/v1",
    "description": "Especificação OpenAPI para validação de cenários de integração de usuários e produtos",
    "swagger": "#####\nopenapi: 3.0.3\ninfo:\n  title: API de Usuários e Produtos\n  version: 1.0.0\n  description: API para cadastro de usuários e consulta de produtos protegida por autenticação.\nservers:\n  - url: http://localhost:8080/api/v1\npaths:\n  /users:\n    post:\n      summary: Criar usuário\n      requestBody:\n        required: true\n        content:\n          application/json:\n            schema:\n              type: object\n              required: [name, email, password, phone, address]\n              properties:\n                name:\n                  type: string\n                email:\n                  type: string\n                  format: email\n                password:\n                  type: string\n                  minLength: 8\n                phone:\n                  type: string\n                address:\n                  type: string\n      responses:\n        '201':\n          description: Usuário criado com sucesso\n        '400':\n          description: Dados inválidos ou e-mail duplicado\n  /products/{id}:\n    get:\n      summary: Buscar produto por id\n      security:\n        - bearerAuth: []\n      parameters:\n        - in: path\n          name: id\n          required: true\n          schema:\n            type: integer\n      responses:\n        '200':\n          description: Produto localizado\n        '401':\n          description: Token ausente ou inválido\n        '404':\n          description: Produto não encontrado\ncomponents:\n  securitySchemes:\n    bearerAuth:\n      type: http\n      scheme: bearer\n      bearerFormat: JWT\n#####"
  },
  "testData": {
    "usuarioValido": {
      "email": "rogeriorocha@provedor.br",
      "password": "rogeriomrocha",
      "name": "Rogerio Rocha",
      "phone": "+55 123 456 78 90",
      "address": "Logradouro 48"
    },
    "usuarioDuplicado": {
      "email": "rogeriorocha@provedor.br",
      "password": "rogeriomrocha",
      "name": "Rogerio Rocha",
      "phone": "+55 123 456 78 90",
      "address": "Logradouro 48"
    },
    "usuarioInvalidoEmail": {
      "email": "email-invalido",
      "password": "rogeriomrocha",
      "name": "Rogerio Rocha",
      "phone": "+55 123 456 78 90",
      "address": "Logradouro 48"
    },
    "usuarioSenhaFraca": {
      "email": "rogerio.senha.fraca@provedor.br",
      "password": "123",
      "name": "Rogerio Rocha",
      "phone": "+55 123 456 78 90",
      "address": "Logradouro 48"
    },
    "tokenValido": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.token.valid",
    "tokenInvalido": "token.invalido"
  },
  "scenarios": [
    {
      "id": "TC-USER-01",
      "name": "Criação com sucesso",
      "type": "valid",
      "endpoint": {
        "method": "POST",
        "path": "/users"
      },
      "preconditions": [
        "Banco de dados ativo",
        "E-mail 'rogeriorocha@provedor.br' ainda não cadastrado"
      ],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "rogeriorocha@provedor.br",
          "password": "rogeriomrocha",
          "name": "Rogerio Rocha",
          "phone": "+55 123 456 78 90",
          "address": "Logradouro 48"
        }
      },
      "expectedStatus": 201,
      "assertions": [
        "statusCode == 201",
        "response.body.id existe e é diferente de nulo",
        "response.body.email == 'rogeriorocha@provedor.br'",
        "response.body.name == 'Rogerio Rocha'",
        "response.body.password não existe no payload de resposta"
      ]
    },
    {
      "id": "TC-USER-02",
      "name": "Bloqueio por e-mail duplicado",
      "type": "invalid",
      "endpoint": {
        "method": "POST",
        "path": "/users"
      },
      "preconditions": [
        "Usuário com e-mail 'rogeriorocha@provedor.br' já cadastrado"
      ],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "rogeriorocha@provedor.br",
          "password": "rogeriomrocha",
          "name": "Rogerio Rocha",
          "phone": "+55 123 456 78 90",
          "address": "Logradouro 48"
        }
      },
      "expectedStatus": 400,
      "assertions": [
        "statusCode == 400",
        "response.body.message contém 'e-mail já está em uso' ou equivalente",
        "response.body.error indica regra de negócio de duplicidade"
      ]
    },
    {
      "id": "TC-USER-03",
      "name": "Erro de validação por e-mail inválido",
      "type": "invalid",
      "endpoint": {
        "method": "POST",
        "path": "/users"
      },
      "preconditions": [],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "email-invalido",
          "password": "rogeriomrocha",
          "name": "Rogerio Rocha",
          "phone": "+55 123 456 78 90",
          "address": "Logradouro 48"
        }
      },
      "expectedStatus": 400,
      "assertions": [
        "statusCode == 400",
        "response.body.message contém indicação de e-mail inválido",
        "response.body.errors.email está presente"
      ]
    },
    {
      "id": "TC-USER-04",
      "name": "Erro de validação por senha fraca",
      "type": "invalid",
      "endpoint": {
        "method": "POST",
        "path": "/users"
      },
      "preconditions": [],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "rogerio.senha.fraca@provedor.br",
          "password": "123",
          "name": "Rogerio Rocha",
          "phone": "+55 123 456 78 90",
          "address": "Logradouro 48"
        }
      },
      "expectedStatus": 400,
      "assertions": [
        "statusCode == 400",
        "response.body.message contém 'senha' e 'mínimo' ou 'forte'",
        "response.body.errors.password está presente"
      ]
    },
    {
      "id": "TC-USER-05",
      "name": "Erro ao tentar cadastrar com campos obrigatórios ausentes",
      "type": "invalid",
      "endpoint": {
        "method": "POST",
        "path": "/users"
      },
      "preconditions": [],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "rogerio@provedor.br",
          "password": "rogeriomrocha"
        }
      },
      "expectedStatus": 400,
      "assertions": [
        "statusCode == 400",
        "response.body.errors contém name, phone e address como obrigatórios",
        "response.body.message indica falha de validação"
      ]
    },
    {
      "id": "TC-PRODUCT-01",
      "name": "Busca de produto com sucesso",
      "type": "valid",
      "endpoint": {
        "method": "GET",
        "path": "/products/99"
      },
      "preconditions": [
        "Existe produto com id 99 cadastrado no catálogo",
        "Token de autenticação válido foi emitido"
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.token.valid",
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 200,
      "assertions": [
        "statusCode == 200",
        "response.body.id == 99",
        "response.body.nome presente",
        "response.body.preco presente e numérico",
        "response.body contém estrutura explícita de produto"
      ]
    },
    {
      "id": "TC-PRODUCT-02",
      "name": "Busca sem autenticação",
      "type": "invalid",
      "endpoint": {
        "method": "GET",
        "path": "/products/99"
      },
      "preconditions": [],
      "request": {
        "headers": {
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 401,
      "assertions": [
        "statusCode == 401",
        "response.body.message contém 'token não foi fornecido' ou 'unauthorized'",
        "response.body.error indica autenticação obrigatória"
      ]
    },
    {
      "id": "TC-PRODUCT-03",
      "name": "Token inválido",
      "type": "invalid",
      "endpoint": {
        "method": "GET",
        "path": "/products/99"
      },
      "preconditions": [
        "Token informado é inválido ou expirado"
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer token.invalido",
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 401,
      "assertions": [
        "statusCode == 401",
        "response.body.message contém 'token inválido' ou 'assinado'",
        "response.body.error indica falha na autenticação"
      ]
    },
    {
      "id": "TC-PRODUCT-04",
      "name": "Produto não localizado",
      "type": "invalid",
      "endpoint": {
        "method": "GET",
        "path": "/products/999999"
      },
      "preconditions": [
        "ID 999999 não existe no catálogo",
        "Token de autenticação válido foi emitido"
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.token.valid",
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 404,
      "assertions": [
        "statusCode == 404",
        "response.body.message contém 'produto não encontrado'",
        "response.body.error indica ausência do recurso"
      ]
    },
    {
      "id": "TC-PRODUCT-05",
      "name": "Parâmetro de rota inválido",
      "type": "invalid",
      "endpoint": {
        "method": "GET",
        "path": "/products/abc"
      },
      "preconditions": [
        "Token de autenticação válido foi emitido"
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.token.valid",
          "Content-Type": "application/json"
        }
      },
      "expectedStatus": 400,
      "assertions": [
        "statusCode == 400",
        "response.body.message contém 'invalid integer' ou 'path parameter inválido'",
        "response.body.errors.id está presente"
      ]
    }
  ]
}
